#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$HOME/Projects/SalonFlowAI"
BACKEND="$ROOT/backend"
PIDFILE="$BACKEND/.ghost-backend.pid"
LOGFILE="$BACKEND/.ghost-backend.log"
HEALTH_URL="http://127.0.0.1:8000/healthz"

backend_pid() {
  if [[ -f "$PIDFILE" ]]; then
    cat "$PIDFILE"
  fi
}

backend_alive() {
  local pid
  pid="$(backend_pid || true)"
  [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null
}

start_backend() {
  if backend_alive; then
    echo "ℹ️ SalonFlow backend already running with PID $(backend_pid)."
    return 0
  fi

  rm -f "$PIDFILE"

  if ss -ltn | awk '{print $4}' | grep -Eq '(^|:)8000$'; then
    echo "❌ Port 8000 is occupied. Backend was not started."
    ss -ltnp | grep ':8000' || true
    return 1
  fi

  cd "$BACKEND"

  nohup .venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --reload \
    > "$LOGFILE" 2>&1 &

  echo "$!" > "$PIDFILE"

  for _ in {1..20}; do
    if ! backend_alive; then
      echo "❌ SalonFlow backend process exited during startup."
      tail -n 100 "$LOGFILE" || true
      rm -f "$PIDFILE"
      return 1
    fi

    if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
      echo "✅ SalonFlow backend healthy — PID $(backend_pid)."
      return 0
    fi

    sleep 0.5
  done

  echo "❌ Backend started but health check failed."
  tail -n 100 "$LOGFILE" || true
  return 1
}

stop_backend() {
  local pid
  pid="$(backend_pid || true)"

  if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true

    for _ in {1..20}; do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.25
    done

    kill -9 "$pid" 2>/dev/null || true
  fi

  # Cleanup only this project's uvicorn command if a stale reload child remains.
  pkill -f "$BACKEND/.venv/bin/uvicorn app.main:app" 2>/dev/null || true
  pkill -f "\.venv/bin/uvicorn app.main:app --host 127\.0\.0\.1 --port 8000" 2>/dev/null || true

  rm -f "$PIDFILE"
  echo "✅ SalonFlow backend stopped."
}

case "${1:-status}" in
  start)
    docker start salonflow-mongo >/dev/null 2>&1 || true
    start_backend
    echo "👻 GhostSalon backend + mongo started"
    ;;

  stop)
    stop_backend
    docker stop salonflow-mongo >/dev/null 2>&1 || true
    echo "👻 GhostSalon backend + mongo stopped"
    ;;

  restart)
    stop_backend
    docker stop salonflow-mongo >/dev/null 2>&1 || true
    sleep 1
    docker start salonflow-mongo >/dev/null 2>&1 || true
    start_backend
    echo "👻 GhostSalon restarted"
    ;;

  status)
    echo "=== Mongo ==="
    docker ps \
      --filter "name=^/salonflow-mongo$" \
      --format 'table {{.ID}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}\t{{.Names}}'

    echo "=== Backend ==="
    if backend_alive; then
      pid="$(backend_pid)"
      ps -p "$pid" -o pid,user,etime,cmd
    else
      echo "NOT RUNNING"
    fi

    echo "=== Port 8000 ==="
    ss -ltnp | grep ':8000' || echo "NOT LISTENING"

    echo "=== Health ==="
    curl -fsS "$HEALTH_URL" || echo "UNHEALTHY"
    echo
    ;;

  verify)
    curl -fsS "$HEALTH_URL"
    echo
    ;;

  logs)
    tail -n 120 "$LOGFILE"
    ;;

  *)
    echo "Usage: ./ghostsalon {start|stop|restart|status|verify|logs}"
    exit 1
    ;;
esac
