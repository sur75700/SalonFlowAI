#!/usr/bin/env bash

PROJECT_ROOT="${HOME}/Projects/SalonFlowAI"
BACKEND_DIR="${PROJECT_ROOT}/backend"

MONGO_CONTAINER="salonflow-mongo"
MONGO_VOLUME="mongo_data"
MONGO_DATABASE="salonflowai"
MONGO_HOST="127.0.0.1"
MONGO_PORT="27017"

BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
BACKEND_HEALTH_URL="http://${BACKEND_HOST}:${BACKEND_PORT}/healthz"

STATE_DIR="${PROJECT_ROOT}/.ghostsalon"
RUN_DIR="${STATE_DIR}/run"
LOG_DIR="${STATE_DIR}/logs"

BACKEND_PID_FILE="${RUN_DIR}/backend.pid"
BACKEND_LOG_FILE="${LOG_DIR}/backend.log"

mkdir -p "${RUN_DIR}" "${LOG_DIR}"

ghostsalon_color_enabled() {
  [ -t 1 ] &&
    [ "${TERM:-dumb}" != "dumb" ] &&
    [ -z "${NO_COLOR:-}" ]
}

if ghostsalon_color_enabled; then
  GHOSTSALON_BLUE=$'\033[1;34m'
  GHOSTSALON_CYAN=$'\033[1;36m'
  GHOSTSALON_GREEN=$'\033[1;32m'
  GHOSTSALON_YELLOW=$'\033[1;33m'
  GHOSTSALON_RED=$'\033[1;31m'
  GHOSTSALON_RESET=$'\033[0m'
else
  GHOSTSALON_BLUE=""
  GHOSTSALON_CYAN=""
  GHOSTSALON_GREEN=""
  GHOSTSALON_YELLOW=""
  GHOSTSALON_RED=""
  GHOSTSALON_RESET=""
fi

banner() {
  printf '%s====================================================%s\n' \
    "${GHOSTSALON_BLUE}" \
    "${GHOSTSALON_RESET}"

  printf '%s%s%s\n' \
    "${GHOSTSALON_BLUE}" \
    "$1" \
    "${GHOSTSALON_RESET}"

  printf '%s====================================================%s\n' \
    "${GHOSTSALON_BLUE}" \
    "${GHOSTSALON_RESET}"
}

section() {
  printf '\n%s── %s ──%s\n' \
    "${GHOSTSALON_CYAN}" \
    "$1" \
    "${GHOSTSALON_RESET}"
}

success() {
  printf '%s✅ %s%s\n' \
    "${GHOSTSALON_GREEN}" \
    "$1" \
    "${GHOSTSALON_RESET}"
}

info() {
  printf '%sℹ️  %s%s\n' \
    "${GHOSTSALON_BLUE}" \
    "$1" \
    "${GHOSTSALON_RESET}"
}

warning() {
  printf '%s⚠️  %s%s\n' \
    "${GHOSTSALON_YELLOW}" \
    "$1" \
    "${GHOSTSALON_RESET}"
}

failure() {
  printf '%s❌ %s%s\n' \
    "${GHOSTSALON_RED}" \
    "$1" \
    "${GHOSTSALON_RESET}"
}

container_exists() {
  docker inspect "${MONGO_CONTAINER}" >/dev/null 2>&1
}

container_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "${MONGO_CONTAINER}" 2>/dev/null)" = "true" ]
}

mongo_data_volume() {
  docker inspect "${MONGO_CONTAINER}" \
    --format '{{range .Mounts}}{{if eq .Destination "/data/db"}}{{.Name}}{{end}}{{end}}' \
    2>/dev/null
}

mongo_port_owner() {
  docker ps \
    --filter "publish=${MONGO_PORT}" \
    --format '{{.Names}}' \
    2>/dev/null |
    head -n 1
}

mongo_ping() {
  docker exec "${MONGO_CONTAINER}" \
    mongosh \
    --quiet \
    --eval 'db.adminCommand({ping: 1}).ok' \
    2>/dev/null |
    grep -q '^1$'
}

mongo_admin_count() {
  docker exec "${MONGO_CONTAINER}" \
    mongosh \
    --quiet \
    --eval "db.getSiblingDB('${MONGO_DATABASE}').admin_users.countDocuments({})" \
    2>/dev/null |
    tail -n 1
}

pid_belongs_to_backend() {
  local pid="${1:-}"
  local cwd=""
  local cmdline=""

  [ -n "${pid}" ] || return 1
  [ -d "/proc/${pid}" ] || return 1

  cwd="$(
    readlink -f "/proc/${pid}/cwd" \
      2>/dev/null ||
      true
  )"

  [ "${cwd}" = "${BACKEND_DIR}" ] || return 1

  cmdline="$(
    tr '\0' ' ' \
      <"/proc/${pid}/cmdline" \
      2>/dev/null ||
      true
  )"

  printf '%s\n' "${cmdline}" |
    grep -qE \
      "uvicorn[[:space:]]+app\\.main:app.*--host[[:space:]]+${BACKEND_HOST}.*--port[[:space:]]+${BACKEND_PORT}"
}

backend_pid() {
  local pid=""

  if [ -f "${BACKEND_PID_FILE}" ]; then
    pid="$(
      cat "${BACKEND_PID_FILE}" \
        2>/dev/null
    )"

    if pid_belongs_to_backend "${pid}"; then
      printf '%s\n' "${pid}"
      return 0
    fi
  fi

  while IFS= read -r pid; do
    if pid_belongs_to_backend "${pid}"; then
      printf '%s\n' "${pid}"
      return 0
    fi
  done < <(
    pgrep -f \
      "uvicorn app\\.main:app" \
      2>/dev/null ||
      true
  )
}

backend_running() {
  local pid
  pid="$(backend_pid)"

  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

backend_health() {
  curl \
    --silent \
    --fail \
    --max-time 3 \
    "${BACKEND_HEALTH_URL}" \
    >/dev/null 2>&1
}

backend_db_probe() {
  (
    cd "${BACKEND_DIR}" || return 1

    .venv/bin/python - <<'PY'
import asyncio

from motor.motor_asyncio import AsyncIOMotorClient

from app.core.config import settings


async def main() -> None:
    client = AsyncIOMotorClient(
        settings.mongo_url,
        serverSelectionTimeoutMS=4000,
    )

    try:
        ping = await client.admin.command("ping")

        if ping.get("ok") != 1:
            raise RuntimeError("Mongo ping failed")

        db = client[settings.mongo_db_name]
        count = await db.admin_users.count_documents({})

        if count < 1:
            raise RuntimeError("admin_users collection is empty")

        print(count)
    finally:
        client.close()


asyncio.run(main())
PY
  ) >/dev/null 2>&1
}

port_listening() {
  local port="$1"

  ss -ltn 2>/dev/null |
    awk '{print $4}' |
    grep -Eq "(^|:)${port}$"
}

mongo_bind_address() {
  docker port "${MONGO_CONTAINER}" 27017/tcp 2>/dev/null |
    head -n 1
}
# BEGIN PHASE 62C4A-P0 LOG ROTATION
# Bounded operational logging policy for GhostSalon backend output.
_GS_ROTATION_SCRIPT_DIR="$(
  cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd
)"
GHOSTSALON_ROTATION_ROOT="$(
  cd "${_GS_ROTATION_SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd
)"
unset _GS_ROTATION_SCRIPT_DIR

GHOSTSALON_LOG_DIR="${GHOSTSALON_LOG_DIR:-${GHOSTSALON_ROTATION_ROOT}/.ghostsalon/logs}"
GHOSTSALON_BACKEND_LOG="${GHOSTSALON_BACKEND_LOG:-${GHOSTSALON_LOG_DIR}/backend.log}"
GHOSTSALON_LOG_ARCHIVE_DIR="${GHOSTSALON_LOG_ARCHIVE_DIR:-${GHOSTSALON_LOG_DIR}/archive}"
GHOSTSALON_LOG_STATE_DIR="${GHOSTSALON_LOG_STATE_DIR:-${GHOSTSALON_ROTATION_ROOT}/.ghostsalon/state}"
GHOSTSALON_LOG_ROTATION_STATE="${GHOSTSALON_LOG_ROTATION_STATE:-${GHOSTSALON_LOG_STATE_DIR}/backend-log-rotation.env}"
GHOSTSALON_LOG_ROTATION_LOCK="${GHOSTSALON_LOG_ROTATION_LOCK:-${GHOSTSALON_LOG_STATE_DIR}/backend-log-rotation.lock}"

GHOSTSALON_LOG_ROTATE_BYTES="${GHOSTSALON_LOG_ROTATE_BYTES:-104857600}"
GHOSTSALON_LOG_RETAIN_COUNT="${GHOSTSALON_LOG_RETAIN_COUNT:-7}"
GHOSTSALON_LOG_RETAIN_DAYS="${GHOSTSALON_LOG_RETAIN_DAYS:-14}"
GHOSTSALON_LOG_RETAIN_BYTES="${GHOSTSALON_LOG_RETAIN_BYTES:-1073741824}"
GHOSTSALON_LOG_LOCK_WAIT="${GHOSTSALON_LOG_LOCK_WAIT:-30}"

ghostsalon_backend_log_bytes() {
  if [[ -f "$GHOSTSALON_BACKEND_LOG" ]]; then
    stat -c '%s' "$GHOSTSALON_BACKEND_LOG" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

ghostsalon_backend_log_mib() {
  local bytes
  bytes="$(ghostsalon_backend_log_bytes)"
  echo $((bytes / 1024 / 1024))
}

ghostsalon_backend_log_rotation_required() {
  local bytes
  bytes="$(ghostsalon_backend_log_bytes)"
  (( bytes >= GHOSTSALON_LOG_ROTATE_BYTES ))
}

ghostsalon_backend_log_rotation_status() {
  local bytes mib archives retained_bytes required last_status last_archive
  bytes="$(ghostsalon_backend_log_bytes)"
  mib=$((bytes / 1024 / 1024))
  required=NO
  (( bytes >= GHOSTSALON_LOG_ROTATE_BYTES )) && required=YES

  archives=0
  retained_bytes=0
  if [[ -d "$GHOSTSALON_LOG_ARCHIVE_DIR" ]]; then
    archives="$(
      find "$GHOSTSALON_LOG_ARCHIVE_DIR" \
        -maxdepth 1 \
        -type f \
        -name 'backend-*.log.gz' \
        -printf '.' \
        2>/dev/null \
        | wc -c \
        | tr -d ' '
    )"
    retained_bytes="$(
      find "$GHOSTSALON_LOG_ARCHIVE_DIR" \
        -maxdepth 1 \
        -type f \
        -name 'backend-*.log.gz' \
        -printf '%s\n' \
        2>/dev/null \
        | awk '{sum += $1} END {print sum + 0}'
    )"
  fi

  last_status=NONE
  last_archive=NONE
  if [[ -r "$GHOSTSALON_LOG_ROTATION_STATE" ]]; then
    last_status="$(
      awk -F= '$1=="LAST_STATUS"{print substr($0,index($0,"=")+1)}' \
        "$GHOSTSALON_LOG_ROTATION_STATE" \
        | tail -n 1
    )"
    last_archive="$(
      awk -F= '$1=="LAST_ARCHIVE"{print substr($0,index($0,"=")+1)}' \
        "$GHOSTSALON_LOG_ROTATION_STATE" \
        | tail -n 1
    )"
    [[ -n "$last_status" ]] || last_status=UNKNOWN
    [[ -n "$last_archive" ]] || last_archive=NONE
  fi

  echo "Active log:       ${mib} MiB (${bytes} bytes)"
  echo "Rotation needed:  $required"
  echo "Archived logs:    $archives"
  echo "Archived bytes:   $retained_bytes"
  echo "Last status:      $last_status"
  echo "Last archive:     $last_archive"
}
# END PHASE 62C4A-P0 LOG ROTATION
