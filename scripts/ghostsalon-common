#!/usr/bin/env bash

PROJECT_ROOT="${HOME}/Projects/SalonFlowAI"
BACKEND_DIR="${PROJECT_ROOT}/backend"

MONGO_CONTAINER="salonflow-mongo"
MONGO_VOLUME="mongo_data"
MONGO_DATABASE="salonflowai"
MONGO_HOST="127.0.0.1"
MONGO_PORT="27017"

BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
BACKEND_HEALTH_URL="http://${BACKEND_HOST}:${BACKEND_PORT}/healthz"

STATE_DIR="${PROJECT_ROOT}/.ghostsalon"
RUN_DIR="${STATE_DIR}/run"
LOG_DIR="${STATE_DIR}/logs"

BACKEND_PID_FILE="${RUN_DIR}/backend.pid"
BACKEND_LOG_FILE="${LOG_DIR}/backend.log"

mkdir -p "${RUN_DIR}" "${LOG_DIR}"

section() {
  printf '\n── %s ──\n' "$1"
}

success() {
  printf '✅ %s\n' "$1"
}

info() {
  printf 'ℹ️  %s\n' "$1"
}

warning() {
  printf '⚠️  %s\n' "$1"
}

failure() {
  printf '❌ %s\n' "$1"
}

container_exists() {
  docker inspect "${MONGO_CONTAINER}" >/dev/null 2>&1
}

container_running() {
  [ "$(docker inspect -f '{{.State.Running}}' "${MONGO_CONTAINER}" 2>/dev/null)" = "true" ]
}

mongo_data_volume() {
  docker inspect "${MONGO_CONTAINER}" \
    --format '{{range .Mounts}}{{if eq .Destination "/data/db"}}{{.Name}}{{end}}{{end}}' \
    2>/dev/null
}

mongo_port_owner() {
  docker ps \
    --filter "publish=${MONGO_PORT}" \
    --format '{{.Names}}' \
    2>/dev/null |
    head -n 1
}

mongo_ping() {
  docker exec "${MONGO_CONTAINER}" \
    mongosh \
    --quiet \
    --eval 'db.adminCommand({ping: 1}).ok' \
    2>/dev/null |
    grep -q '^1$'
}

mongo_admin_count() {
  docker exec "${MONGO_CONTAINER}" \
    mongosh \
    --quiet \
    --eval "db.getSiblingDB('${MONGO_DATABASE}').admin_users.countDocuments({})" \
    2>/dev/null |
    tail -n 1
}

pid_belongs_to_backend() {
  local pid="${1:-}"
  local cwd=""
  local cmdline=""

  [ -n "${pid}" ] || return 1
  [ -d "/proc/${pid}" ] || return 1

  cwd="$(
    readlink -f "/proc/${pid}/cwd" \
      2>/dev/null ||
      true
  )"

  [ "${cwd}" = "${BACKEND_DIR}" ] || return 1

  cmdline="$(
    tr '\0' ' ' \
      <"/proc/${pid}/cmdline" \
      2>/dev/null ||
      true
  )"

  printf '%s\n' "${cmdline}" |
    grep -qE \
      "uvicorn[[:space:]]+app\\.main:app.*--host[[:space:]]+${BACKEND_HOST}.*--port[[:space:]]+${BACKEND_PORT}"
}

backend_pid() {
  local pid=""

  if [ -f "${BACKEND_PID_FILE}" ]; then
    pid="$(
      cat "${BACKEND_PID_FILE}" \
        2>/dev/null
    )"

    if pid_belongs_to_backend "${pid}"; then
      printf '%s\n' "${pid}"
      return 0
    fi
  fi

  while IFS= read -r pid; do
    if pid_belongs_to_backend "${pid}"; then
      printf '%s\n' "${pid}"
      return 0
    fi
  done < <(
    pgrep -f \
      "uvicorn app\\.main:app" \
      2>/dev/null ||
      true
  )
}

backend_running() {
  local pid
  pid="$(backend_pid)"

  [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null
}

backend_health() {
  curl \
    --silent \
    --fail \
    --max-time 3 \
    "${BACKEND_HEALTH_URL}" \
    >/dev/null 2>&1
}

backend_db_probe() {
  (
    cd "${BACKEND_DIR}" || return 1

    .venv/bin/python - <<'PY'
import asyncio

from motor.motor_asyncio import AsyncIOMotorClient

from app.core.config import settings


async def main() -> None:
    client = AsyncIOMotorClient(
        settings.mongo_url,
        serverSelectionTimeoutMS=4000,
    )

    try:
        ping = await client.admin.command("ping")

        if ping.get("ok") != 1:
            raise RuntimeError("Mongo ping failed")

        db = client[settings.mongo_db_name]
        count = await db.admin_users.count_documents({})

        if count < 1:
            raise RuntimeError("admin_users collection is empty")

        print(count)
    finally:
        client.close()


asyncio.run(main())
PY
  ) >/dev/null 2>&1
}

port_listening() {
  local port="$1"

  ss -ltn 2>/dev/null |
    awk '{print $4}' |
    grep -Eq "(^|:)${port}$"
}

mongo_bind_address() {
  docker port "${MONGO_CONTAINER}" 27017/tcp 2>/dev/null |
    head -n 1
}
